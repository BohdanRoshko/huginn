<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Mac shell: a menu bar app over the shared core (../core). Built only on a Mac (GitHub Actions); the
       Windows machine cannot build it. AppKit for the UI, AVFoundation for the mic, ScreenCaptureKit for the
       system audio, a CGEvent tap for the dictation key. -->
  <PropertyGroup>
    <TargetFramework>net10.0-macos</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <AssemblyName>Huginn</AssemblyName>
    <RootNamespace>Huginn</RootNamespace>
    <!-- Same id as the Swift app it replaces, so macOS treats it as the same app. -->
    <ApplicationId>io.github.bohdanroshko1.huginn</ApplicationId>
    <ApplicationTitle>Huginn</ApplicationTitle>
    <ApplicationDisplayVersion>2.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <!-- Signed ad hoc by CI after the build; no Developer ID, so no hardened runtime. -->
    <EnableCodeSigning>false</EnableCodeSigning>
    <CreatePackage>false</CreatePackage>
    <!-- The core reads JSON by reflection; trimming would cut what it needs. -->
    <LinkMode>None</LinkMode>
    <NoWarn>$(NoWarn);CA1422;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\Huginn.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Whisper's native build: for a -macos target this package adds only the macOS libraries (Metal on arm64). -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- The cleanup LLM's native build for Apple Silicon (Metal). -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.25.0" />
  </ItemGroup>

</Project>
