{
  "manifest_version": 3,
  "name": "Huginn for meetings in the browser",
  "version": "1.3.0",
  "description": "Sends who is talking and snapshots of a shared screen from a call in the browser (Google Meet, Microsoft Teams, Zoom, Slack huddles) to the Huginn recorder on this computer. On Google Meet also raised hands, reactions and chat.",
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js", "site-meet.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://teams.live.com/*"],
      "js": ["content.js", "site-teams.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.zoom.us/wc/*"],
      "js": ["content.js", "site-zoom.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["content.js", "site-slack.js"],
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["http://127.0.0.1:47821/*"]
}
