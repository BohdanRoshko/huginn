<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Huginn</AssemblyName>
    <RootNamespace>Huginn</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WFO1000 is about the WinForms designer; these forms are built in code, never in the designer. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\Huginn.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows capture: WaveIn mic and WASAPI loopback. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- GPU on the RTX 5080 via Vulkan: needs only the NVIDIA driver, no CUDA Toolkit. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <!-- CPU fallback runtime. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- In-process cleanup LLM on Vulkan (runs inside Huginn; dies with the app). -->
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.25.0" />
  </ItemGroup>

</Project>
