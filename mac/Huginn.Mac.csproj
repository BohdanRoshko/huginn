<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Mac shell: a menu bar app over the shared core (../core). Built only on a Mac (GitHub Actions); the
       Windows machine cannot build it. AppKit for the UI, AVFoundation for the mic, ScreenCaptureKit for the
       system audio, a CGEvent tap for the dictation key. -->
  <PropertyGroup>
    <!-- The macOS SDK version is pinned so CI can select the one Xcode it accepts (26.0). -->
    <TargetFramework>net10.0-macos26.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <AssemblyName>Huginn</AssemblyName>
    <RootNamespace>Huginn</RootNamespace>
    <!-- Same id as the Swift app it replaces, so macOS treats it as the same app. -->
    <ApplicationId>io.github.bohdanroshko1.huginn</ApplicationId>
    <ApplicationTitle>Huginn</ApplicationTitle>
    <ApplicationDisplayVersion>2.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <!-- Signed ad hoc by CI after the build; no Developer ID, so no hardened runtime. -->
    <EnableCodeSigning>false</EnableCodeSigning>
    <CreatePackage>false</CreatePackage>
    <!-- The core reads JSON by reflection; trimming would cut what it needs. -->
    <LinkMode>None</LinkMode>
    <NoWarn>$(NoWarn);CA1422;CA1416</NoWarn>
  </PropertyGroup>

  <!-- Whisper.net also carries "__Internal" P/Invokes (LibraryImportInternalWhisper, its iOS path). .NET 10 links the
       runtime statically on macOS and asks the linker for every __Internal symbol, so the link fails. On the Mac
       Whisper.net loads libwhisper.dylib itself (LibraryImportLibWhisper), so these 38 are never called: ignore them.
       The list comes from the P/Invoke table of Whisper.net 1.9.1; check it when that version changes. -->
  <ItemGroup>
    <ReferenceNativeSymbol Include="whisper_ctx_init_openvino_encoder_with_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_free" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_free_params" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_free_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_default_params_by_ref" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_segment_no_speech_prob_from_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_segment_t0_from_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_segment_t1_from_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_segment_text_from_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_token_data_from_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_token_p_from_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_token_text_from_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_lang_id_from_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_n_segments_from_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_n_tokens_from_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_with_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_init_from_buffer_with_params_no_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_init_from_file_with_params_no_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_init_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_lang_auto_detect_with_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_lang_id" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_lang_max_id" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_lang_str" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_log_set" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_pcm_to_mel_with_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_print_system_info" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_default_context_params" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_default_params" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_detect_speech" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_detect_speech_no_reset" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_free" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_free_segments" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_init_from_file_with_params" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_reset_state" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_segments_from_probs" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_segments_get_segment_t0" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_segments_get_segment_t1" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_vad_segments_n_segments" SymbolMode="Ignore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\Huginn.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Whisper's native build (Metal on arm64). Its build targets are NOT imported: they make the macOS SDK link
         libwhisper at build time, and the linker then demands functions the Mac build lacks (OpenVINO). Whisper.net
         loads the library itself at run time, so the target below just copies the files into the bundle. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" ExcludeAssets="build;buildTransitive" GeneratePathProperty="true" />
    <!-- The cleanup LLM's native build for Apple Silicon (Metal). -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.25.0" />
  </ItemGroup>

  <!-- Contents/MonoBundle is the app's base directory; Whisper.net looks for runtimes/macos-arm64 under it. -->
  <Target Name="CopyWhisperNatives" AfterTargets="Build" Condition="'$(AppBundleDir)' != ''">
    <ItemGroup>
      <WhisperNative Include="$(PkgWhisper_net_Runtime)/build/macos-arm64/*" />
    </ItemGroup>
    <Copy SourceFiles="@(WhisperNative)" DestinationFolder="$(AppBundleDir)/Contents/MonoBundle/runtimes/macos-arm64" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Whisper natives copied: @(WhisperNative->'%(Filename)%(Extension)', ', ')" />
  </Target>

</Project>
